; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="炽窑"
config/description="《炽窑》Ember's Kiln — 2D 回合制卡组构筑 Roguelike（战士单职业）"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://art/icons/app/ICO_EmbersKiln.png"
run/max_fps.android=60

[autoload]

TestBridge="*res://test_bridge.gd"
SignalBus="*res://scripts/core/SignalBus.gd"
GameData="*res://scripts/data/GameData.gd"
ProfileState="*res://scripts/core/ProfileState.gd"
ProfileManager="*res://scripts/core/ProfileManager.gd"
WorkshopSystem="*res://scripts/meta/WorkshopSystem.gd"
AdService="*res://scripts/ads/AdService.gd"
AdRewardCoordinator="*res://scripts/ads/AdRewardCoordinator.gd"
RunState="*res://scripts/core/RunState.gd"
RunEndRewardSystem="*res://scripts/meta/RunEndRewardSystem.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
TransitionManager="*res://scripts/core/TransitionManager.gd"
PauseManager="*res://scripts/core/PauseManager.gd"
VFXSystem="*res://scripts/core/VFXSystem.gd"
BattleDirector="*res://scripts/combat/BattleDirector.gd"
ShopInventorySystem="*res://scripts/meta/ShopInventorySystem.gd"
CardAcquireService="*res://scripts/meta/CardAcquireService.gd"
PreRunBuffSystem="*res://scripts/meta/PreRunBuffSystem.gd"
CombatReviveSystem="*res://scripts/meta/CombatReviveSystem.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=1080
window/size/window_height_override=1920
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.984, 0.953, 0.894, 1)
